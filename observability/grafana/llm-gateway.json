{
  "title": "LLM Gateway",
  "uid": "llm-gateway",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus" }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Availability (30d) vs 99.5% SLO",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "uid": "${datasource}" },
      "targets": [{ "expr": "1 - avg_over_time(gateway:error_ratio:rate1h[30d])" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.995 }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Error budget remaining (30d)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "uid": "${datasource}" },
      "targets": [{ "expr": "1 - (avg_over_time(gateway:error_ratio:rate1h[30d]) / 0.005)" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "type": "stat",
      "title": "Spend today (USD)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "uid": "${datasource}" },
      "targets": [{ "expr": "sum(increase(gateway_cost_usd_total[24h]))" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "type": "stat",
      "title": "Cache hit rate",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "uid": "${datasource}" },
      "targets": [{ "expr": "sum(rate(gateway_cache_total{result=\"hit\"}[1h])) / clamp_min(sum(rate(gateway_cache_total[1h])), 1e-9)" }],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "type": "timeseries",
      "title": "Requests by outcome",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "uid": "${datasource}" },
      "targets": [{ "expr": "sum by (outcome) (rate(gateway_requests_total[5m]))", "legendFormat": "{{outcome}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "Error ratio and burn-rate thresholds",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "uid": "${datasource}" },
      "targets": [
        { "expr": "gateway:error_ratio:rate5m", "legendFormat": "5m" },
        { "expr": "gateway:error_ratio:rate1h", "legendFormat": "1h" },
        { "expr": "vector(14.4 * 0.005)", "legendFormat": "fast-burn page" },
        { "expr": "vector(0.005)", "legendFormat": "budget (1x)" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "type": "timeseries",
      "title": "Upstream calls by target and result",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "uid": "${datasource}" },
      "targets": [{ "expr": "sum by (target, result) (rate(gateway_upstream_calls_total[5m]))", "legendFormat": "{{target}} {{result}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "Latency p95 by route / time-to-first-token p95",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "uid": "${datasource}" },
      "targets": [
        { "expr": "gateway:latency_seconds:p95_5m", "legendFormat": "{{route}} full" },
        { "expr": "histogram_quantile(0.95, sum by (le, route) (rate(gateway_request_seconds_bucket{mode=\"ttft\"}[5m])))", "legendFormat": "{{route}} ttft" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "state-timeline",
      "title": "Circuit breakers (1 = open)",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 6 },
      "datasource": { "uid": "${datasource}" },
      "targets": [{ "expr": "max by (target) (gateway_breaker_open)", "legendFormat": "{{target}}" }]
    },
    {
      "type": "bargauge",
      "title": "Spend per key (24h, USD)",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 6 },
      "datasource": { "uid": "${datasource}" },
      "targets": [{ "expr": "sort_desc(sum by (key) (increase(gateway_cost_usd_total[24h])))", "legendFormat": "{{key}}" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    }
  ]
}
